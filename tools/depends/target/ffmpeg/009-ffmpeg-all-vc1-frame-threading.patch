+/**
+ * With frame threading, wait until another thread has finished decoding a
+ * picture, so that the properties of its frame are final before the frame
+ * is output. The frame threading code only guarantees that for the data.
+ */
+static void vc1_await_picture(const AVCodecContext *avctx, const MPVPicture *pic)
+{
+    if (HAVE_THREADS && (avctx->active_thread_type & FF_THREAD_FRAME))
+        ff_thread_progress_await(&pic->progress, INT_MAX);
+}
