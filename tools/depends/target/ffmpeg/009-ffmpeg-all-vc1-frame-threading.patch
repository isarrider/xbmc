+static inline int ff_vc1_ref_progress(const MpegEncContext *s,
+                                      const MPVPicture *ref,
+                                      int line, int field)
+{
+    line = FFMAX(line, 0);
+    if (!ref->field_picture) {
+        return (field < 0 ? line : 2 * line + field) >> 4;
